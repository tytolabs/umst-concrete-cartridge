/target
**/*.rs.bk
# Cargo.lock tracked for reproducible CI (Phase 4)

.env
.env.local
.venv*/

.DS_Store
Thumbs.db
Desktop/
.cargo/config.toml
.cargo/config.toml.local-*

# Agent-layer local memory (operator SQLite + JSONL sidecars)
.umst-memory/

.idea/
.vscode/
*.iml
.fleet/

*.swp
*.swo
*~

# Python build artefacts (PyO3 + maturin)
__pycache__/
*.py[cod]
*$py.class
*.abi3.so
*.so

# Notebook side-effect (the canonical figure lives inside the .ipynb)
notebooks/audit_three_panels.png

# Local notebook scratch (keep committed striatus/beam artefacts under notebooks/_artifacts/ unignored)
notebooks/_tmp/
notebooks/_artifacts/frames/

# NumPy blobs under notebooks/_artifacts (GIF/STL/OBJ/JSON remain tracked)
notebooks/_artifacts/**/*.npy
notebooks/_artifacts/**/*.npz

# Striatus shell demo dumps (never commit bulky npy from example runs)
crates/umst-concrete-cartridge/examples/_artifacts/shell/*.npy
# RC beam demo iteration dumps + manifest (regenerated by optimize_rc_beam / synthetic helper)
crates/umst-concrete-cartridge/examples/_artifacts/beam/

# Local research / audit memos not yet promoted to tracked docs
docs/Category-of-Material-Updates.md
docs/PENDING_TRACK1_AUDIT.md
docs/STRIATUS_JFNK_INTEGRATION_SURVEY.md
docs/VRAM.md
docs/verification/

# Local optimisation / agent logs
opt*.log
shell_*.log
*_track*_*.log
rust_out
.umst-memory/

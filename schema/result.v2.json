{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tytolabs/umst-concrete-cartridge/schema/result.v2.json",
  "title": "UMST Concrete PredictionResult v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compressive_strength_mpa",
    "yield_stress_pa",
    "degree_of_hydration",
    "gwp_kg_co2_eq_per_m3",
    "safety_margin",
    "calibration_profile",
    "calibration_model",
    "formal_anchor",
    "axioms",
    "warnings",
    "schema_version"
  ],
  "properties": {
    "compressive_strength_mpa": {
      "type": "number",
      "description": "Predicted compressive strength (MPa)"
    },
    "yield_stress_pa": {
      "type": "number",
      "minimum": 0.0,
      "description": "Predicted static yield stress (Pa)"
    },
    "degree_of_hydration": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Degree of hydration alpha (dimensionless)"
    },
    "gwp_kg_co2_eq_per_m3": {
      "type": "number",
      "description": "Embodied GWP indicator (kg CO2-eq per m3 concrete)"
    },
    "safety_margin": {
      "type": "number",
      "minimum": 0.0,
      "description": "Non-negative admissibility margin"
    },
    "calibration_profile": {
      "type": "string",
      "description": "Bundled or file-backed calibration profile id"
    },
    "calibration_model": {
      "type": "string",
      "description": "Homogeneous model discriminator (e.g. powers_gel_space)"
    },
    "formal_anchor": {
      "type": "string",
      "description": "Primary Lean formal anchor URI for the active profile"
    },
    "axioms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "physicalSecondLaw",
          "Classical.choice",
          "propext",
          "Quot.sound"
        ]
      },
      "description": "Subset of axioms depended on by the active profile (Lean closure allowlist)"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-empty when operating outside the active profile regime (no silent extrapolation)"
    },
    "schema_version": {
      "type": "string",
      "const": "result.v2"
    },
    "physics_pipeline": {
      "type": "object",
      "description": "Collapsed-batch tensor physics capsule (see `physics_pipeline.v1` schema_version inside).",
      "additionalProperties": true
    },
    "homogeneous_compare": {
      "type": "object",
      "description": "Legacy homogeneous scalars when `--compare-homogeneous` is set.",
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tytolabs/umst-concrete-cartridge/schema/result.v2.json",
  "title": "UMST Concrete PredictionResult v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compressive_strength_mpa",
    "yield_stress_pa",
    "degree_of_hydration",
    "gwp_kg_co2_eq_per_m3",
    "safety_margin",
    "calibration_profile",
    "calibration_model",
    "formal_anchor",
    "axioms",
    "warnings",
    "schema_version",
    "optical"
  ],
  "properties": {
    "compressive_strength_mpa": {
      "type": "number",
      "description": "Predicted compressive strength (MPa)"
    },
    "yield_stress_pa": {
      "type": "number",
      "minimum": 0.0,
      "description": "Predicted static yield stress (Pa)"
    },
    "degree_of_hydration": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Degree of hydration alpha (dimensionless)"
    },
    "gwp_kg_co2_eq_per_m3": {
      "type": "number",
      "description": "Embodied GWP indicator (kg CO2-eq per m3 concrete)"
    },
    "safety_margin": {
      "type": "number",
      "minimum": 0.0,
      "description": "Non-negative admissibility margin"
    },
    "calibration_profile": {
      "type": "string",
      "description": "Bundled or file-backed calibration profile id"
    },
    "calibration_model": {
      "type": "string",
      "description": "Homogeneous model discriminator (e.g. powers_gel_space)"
    },
    "formal_anchor": {
      "type": "string",
      "description": "Primary Lean formal anchor URI for the active profile"
    },
    "axioms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "physicalSecondLaw",
          "Classical.choice",
          "propext",
          "Quot.sound"
        ]
      },
      "description": "Subset of axioms depended on by the active profile (Lean closure allowlist)"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-empty when operating outside the active profile regime (no silent extrapolation)"
    },
    "schema_version": {
      "type": "string",
      "const": "result.v2"
    },
    "physics_pipeline": {
      "type": "object",
      "description": "Collapsed-batch tensor physics capsule (see `physics_pipeline.v1` schema_version inside).",
      "additionalProperties": true
    },
    "homogeneous_compare": {
      "type": "object",
      "description": "Legacy homogeneous scalars when `--compare-homogeneous` is set.",
      "additionalProperties": true
    },
    "optical": {
      "type": "object",
      "description": "Track H3 audit block: plain-Portland dielectric profile optics at fixed thickness (Fresnel + broadband integrals).",
      "additionalProperties": false,
      "required": [
        "solar_reflectance",
        "uv_absorption",
        "lwir_emissivity",
        "thickness_m",
        "profile",
        "schema_version"
      ],
      "properties": {
        "solar_reflectance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Broadband solar reflectance (400–700 nm Simpson + diffuse fraction)."
        },
        "uv_absorption": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Photocatalytic UV absorption at 365 nm (Beer–Lambert)."
        },
        "lwir_emissivity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Sky-window emissivity (Kirchhoff at ~10.5 μm)."
        },
        "thickness_m": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "description": "Slab thickness used for path-length optics (metres)."
        },
        "profile": {
          "type": "string",
          "description": "Dielectric profile tag (e.g. plain_portland)."
        },
        "schema_version": {
          "type": "string",
          "const": "optical.v1"
        }
      }
    }
  }
}

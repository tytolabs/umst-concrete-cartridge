# Optional local monorepo overrides — copy to `.cargo/config.toml` (gitignored).
# Public CI uses git SHAs from `Cargo.toml` / `.umst-pins.toml` only (W-63 boundary when siblings are private).

[patch."https://github.com/tytolabs/umst-manifold.git"]
umst-manifold = { path = "../umst-manifold" }
umst-runtime = { path = "../umst-manifold/crates/umst-runtime" }
umst-runtime-arena = { path = "../umst-manifold/umst-runtime-arena" }

[patch."https://github.com/tytolabs/umst-ucrs.git"]
umst-ucrs = { path = "../umst-ucrs/Rust" }

[patch."https://github.com/tytolabs/umst-foundations.git"]
umst-gate = { path = "../umst-foundations/crates/umst-gate" }
umst-trust = { path = "../umst-foundations/crates/umst-trust" }

[patch."https://github.com/tytolabs/umst-cartridge-api.git"]
umst-cartridge-api = { path = "../umst-cartridge-api" }

[patch."https://github.com/tytolabs/umst-cartridges.git"]
umst-cartridge-concrete = { path = "../umst-cartridges/crates/materials/umst-cartridge-concrete" }
umst-cartridge-continuum = { path = "../umst-cartridges/crates/atoms/umst-cartridge-continuum" }
umst-cartridge-solid-inelastic = { path = "../umst-cartridges/crates/atoms/umst-cartridge-solid-inelastic" }
umst-cartridge-poromechanics = { path = "../umst-cartridges/crates/atoms/umst-cartridge-poromechanics" }

[patch."https://github.com/tytolabs/umst-chem.git"]
umst-chem = { path = "../umst-chem" }

[patch."https://github.com/tytolabs/umst-cartridge-registry.git"]
umst-cartridge-registry = { path = "../umst-cartridge-registry" }

[patch."https://github.com/tytolabs/umst-semantics.git"]
umst-semantics = { path = "../umst-semantics" }

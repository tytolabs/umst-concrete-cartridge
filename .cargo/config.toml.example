# Local dev patch — copy to `.cargo/config.toml` when testing against sibling umst-manifold.

[patch."https://github.com/tytolabs/umst-manifold.git"]
umst-manifold = { path = "../umst-manifold" }
umst-runtime = { path = "../umst-manifold/crates/umst-runtime" }
umst-runtime-arena = { path = "../umst-manifold/umst-runtime-arena" }
